<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop">
  <local:SectionVisibilityConverter x:Key="SectionVisibility"/><DrawingImage x:Key="StudioLogo"><DrawingImage.Drawing><GeometryDrawing Geometry="M3,5 C3,1 21,1 21,5 C21,9 3,9 3,5 M3,5 L3,19 C3,23 21,23 21,19 L21,5 M3,10 C3,14 21,14 21,10 M3,15 C3,19 21,19 21,15"><GeometryDrawing.Pen><Pen Brush="#0874E8" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
  <SolidColorBrush x:Key="Primary" Color="#0067D9"/>
  <sys:Double x:Key="StudioBodyFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
  <sys:Double x:Key="StudioGridFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
  <sys:Double x:Key="StudioSuiteHeadingSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">23</sys:Double>
  <sys:Double x:Key="StudioCaseHeadingSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">19</sys:Double>
  <sys:Double x:Key="StudioTestRailWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">240</sys:Double>
  <sys:Double x:Key="StudioButtonHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
  <sys:Double x:Key="StudioGridRowHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">34</sys:Double>
  <Thickness x:Key="StudioButtonPadding">12,7</Thickness>
  <Thickness x:Key="StudioTextBoxPadding">8,5</Thickness>
  <!-- Slim scrollbars leave more room for suite columns. The full 12px track remains clickable. -->
  <Style x:Key="StudioScrollThumb" TargetType="Thumb">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#A9B8CA" CornerRadius="4" Margin="3,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#6487AD"/><Setter TargetName="Grip" Property="Margin" Value="2,2"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#0067D9"/><Setter TargetName="Grip" Property="Margin" Value="2,2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="StudioVerticalScrollBar" TargetType="ScrollBar"><Grid Width="12" Background="#F3F6FA"><Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource StudioScrollThumb}" MinHeight="25"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate>
  <ControlTemplate x:Key="StudioHorizontalScrollBar" TargetType="ScrollBar"><Grid Height="12" Background="#F3F6FA"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource StudioScrollThumb}" MinWidth="25"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Height" Value="12"/><Setter Property="Template" Value="{StaticResource StudioVerticalScrollBar}"/><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Template" Value="{StaticResource StudioHorizontalScrollBar}"/><Setter Property="Width" Value="Auto"/></Trigger><Trigger Property="Orientation" Value="Vertical"><Setter Property="Height" Value="Auto"/></Trigger></Style.Triggers></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="{DynamicResource StudioButtonPadding}"/><Setter Property="MinHeight" Value="{DynamicResource StudioButtonHeight}"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#0067D9"/><Setter Property="BorderBrush" Value="#CCD8E6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#102842"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Primary}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Primary}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="{DynamicResource StudioTextBoxPadding}"/><Setter Property="BorderBrush" Value="#CCD8E6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E7EDF5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="{DynamicResource StudioGridRowHeight}"/><Setter Property="FontSize" Value="{DynamicResource StudioGridFontSize}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="Background" Value="White"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="AlternatingRowBackground" Value="#F9FBFE"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EDF2F8"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="#E0E7F0"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="9,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="7"/><Setter Property="BorderBrush" Value="#DCE4EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#62738A"/><Setter Property="Margin" Value="0,10,0,6"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="12,9"/><Setter Property="Foreground" Value="#60738B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#0067D9"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#0067D9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E7F1FF"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CDE0FB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F0F6FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ResourceDictionary>
