<UserControl x:Class="EtlTesting.Desktop.ReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE5F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style x:Key="MetaLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#71839A"/></Style>
  <Style x:Key="MetaValue" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#12253E"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="SmallHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#162B47"/></Style>
  <Style x:Key="StatusColor" TargetType="TextBlock"><Setter Property="Foreground" Value="#64778F"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Passed"><Setter Property="Foreground" Value="#078D58"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="#C5363C"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="#C5363C"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid TextElement.FontSize="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <UniformGrid Columns="5" VerticalAlignment="Center"><StackPanel><TextBlock Text="RUN ID" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding ReportRunId}" Style="{StaticResource MetaValue}" ToolTip="{Binding ReportRunId}" Margin="0,4,12,0"/></StackPanel><StackPanel><TextBlock Text="ENVIRONMENT" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding ReportEnvironment}" Style="{StaticResource MetaValue}" ToolTip="{Binding ReportEnvironment}" Margin="0,4,12,0"/></StackPanel><StackPanel><TextBlock Text="STARTED" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding ReportStarted}" Style="{StaticResource MetaValue}" Margin="0,4,12,0"/></StackPanel><StackPanel><TextBlock Text="STATUS" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding ReportStatus}" Style="{StaticResource MetaValue}" Margin="0,4,12,0"/></StackPanel><StackPanel><TextBlock Text="DURATION" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding ReportDuration}" Style="{StaticResource MetaValue}" Margin="0,4,12,0"/></StackPanel></UniformGrid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding OpenReportCommand}" AutomationProperties.Name="Open HTML report"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="file" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Open HTML"/></StackPanel></Button><Button Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" Margin="0" AutomationProperties.Name="Export run reports"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="save" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Export reports"/></StackPanel></Button></StackPanel>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
   <Border Style="{StaticResource Card}" Background="#EDF5FF" BorderBrush="#C9DFFA" Margin="0,0,8,0" Padding="14,10"><DockPanel><Border DockPanel.Dock="Left" Width="35" Height="35" Background="#DCEBFF" CornerRadius="18" Margin="0,0,11,0"><local:StudioIcon Kind="test" Width="17" Height="17" Foreground="#1169D1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Tests" Foreground="#526882" FontSize="11"/><TextBlock Text="{Binding ReportTestCount}" FontSize="21" FontWeight="Bold" Foreground="#112842"/></StackPanel></DockPanel></Border>
   <Border Style="{StaticResource Card}" Background="#EFFAF5" BorderBrush="#CDEBDD" Margin="0,0,8,0" Padding="14,10"><DockPanel><Border DockPanel.Dock="Left" Width="35" Height="35" Background="#DDF5E8" CornerRadius="18" Margin="0,0,11,0"><local:StudioIcon Kind="check" Width="17" Height="17" Foreground="#078D58" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Passed" Foreground="#526882" FontSize="11"/><TextBlock Text="{Binding ReportPassedCount}" FontSize="21" FontWeight="Bold" Foreground="#078D58"/></StackPanel></DockPanel></Border>
   <Border Style="{StaticResource Card}" Background="#FFF2F2" BorderBrush="#F5D5D7" Margin="0,0,8,0" Padding="14,10"><DockPanel><Border DockPanel.Dock="Left" Width="35" Height="35" Background="#FCE1E3" CornerRadius="18" Margin="0,0,11,0"><local:StudioIcon Kind="close" Width="16" Height="16" Foreground="#CE3339" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Failed / error" Foreground="#526882" FontSize="11"/><TextBlock Text="{Binding ReportFailedCount}" FontSize="21" FontWeight="Bold" Foreground="#C5363C"/></StackPanel></DockPanel></Border>
   <Border Style="{StaticResource Card}" Background="#FFF7EA" BorderBrush="#F3DFC1" Padding="14,10"><DockPanel><Border DockPanel.Dock="Left" Width="35" Height="35" Background="#FFECCB" CornerRadius="18" Margin="0,0,11,0"><local:StudioIcon Kind="reports" Width="17" Height="17" Foreground="#C87A12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Violations" Foreground="#526882" FontSize="11"/><TextBlock Text="{Binding ReportViolationCount}" FontSize="21" FontWeight="Bold" Foreground="#A8650B"/></StackPanel></DockPanel></Border>
  </UniformGrid>
  <TabControl Grid.Row="2" SelectedIndex="1" BorderThickness="0">
   <TabItem Header="Summary"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,2,4"><Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10"><StackPanel><TextBlock Text="What this run means" Style="{StaticResource SmallHeading}"/><TextBlock Text="{Binding ReportNarrative}" Foreground="#526881" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding ReportScope,StringFormat=Scope: {0}}" Foreground="#71839A" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="Validation outcomes" Style="{StaticResource SmallHeading}" Margin="2,0,0,9"/><ItemsControl ItemsSource="{Binding ReportTests}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource SmallHeading}"/><TextBlock Text="{Binding Outcome}" Foreground="#516982" TextWrapping="Wrap" Margin="0,4,10,0"/><TextBlock Text="{Binding Scope}" Foreground="#71839A" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Test.Error}" Foreground="#B8343E" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusColor}" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Counts}" Foreground="#71839A" FontSize="10" TextWrapping="Wrap" TextAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Mismatches"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0,7,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Table" Style="{StaticResource MetaLabel}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding ReportTables}" SelectedItem="{Binding ReportTableFilter}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Category" Style="{StaticResource MetaLabel}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding ReportCategories}" SelectedItem="{Binding ReportCategoryFilter}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Search key, column, value or test" Style="{StaticResource MetaLabel}" Margin="0,0,0,4"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search report evidence"/></StackPanel></Grid>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid Height="230" ItemsSource="{Binding ReportEvidenceRows}" SelectedItem="{Binding SelectedReportEvidence}" AutoGenerateColumns="False" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="1.3*"/><DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="0.9*"/><DataGridTextColumn Header="Business key" Binding="{Binding BusinessKey}" Width="1.5*"/><DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="0.7*"/><DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="0.8*"/><DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="0.8*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.2*"/></DataGrid.Columns></DataGrid></Border>
     <DockPanel Grid.Row="2" Margin="0,7,0,8"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Command="{Binding PreviousPageCommand}" Padding="8,4" Content="← Previous"/><Button Command="{Binding NextPageCommand}" Padding="8,4" Margin="0" Content="Next →"/></StackPanel><TextBlock Text="{Binding EvidenceSummary}" Foreground="#6E8197" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" MaxHeight="220"><Border Style="{StaticResource Card}" Padding="11,7"><StackPanel><TextBlock Text="{Binding SelectedReportEvidence.TestName,StringFormat=Details · {0},TargetNullValue=Select an evidence row}" Style="{StaticResource SmallHeading}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="EXPECTED / SOURCE" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding SelectedReportEvidence.Expected}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding SelectedReportEvidence.BusinessKey}" Foreground="#6B7D94" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="ACTUAL / TARGET" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding SelectedReportEvidence.Actual}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding SelectedReportEvidence.Table}" Foreground="#6B7D94" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="WHY IT MATTERS" Style="{StaticResource MetaLabel}"/><TextBlock Text="{Binding SelectedReportEvidence.Explanation}" Foreground="#334E6C" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding SelectedReportEvidence.Rule,StringFormat=Rule: {0}}" Foreground="#6B7D94" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid><Expander Header="Technical evidence" Margin="0,5,0,0"><ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectedReportEvidence.RawDetails}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/></ScrollViewer></Expander></StackPanel></Border></ScrollViewer>
    </Grid></ScrollViewer></TabItem>
   <TabItem Header="Run details"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="17"><StackPanel><TextBlock Text="Execution context" Style="{StaticResource SmallHeading}"/><TextBlock Text="Recorded run metadata and execution strategy. The live console log is available only during the current session." Foreground="#6E8197" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock Text="{Binding ReportExecutionNotes}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="Current session log" Style="{StaticResource SmallHeading}" Margin="0,18,0,8"/><TextBox Text="{Binding Logs,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalScrollBarVisibility="Auto"/></StackPanel></Border></ScrollViewer></TabItem>
  </TabControl>
 </Grid>
</UserControl>

