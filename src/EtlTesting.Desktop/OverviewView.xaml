<UserControl x:Class="EtlTesting.Desktop.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop" Background="#F4F7FB">
 <UserControl.Resources>
  <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Panel}"><Setter Property="Padding" Value="14"/><Setter Property="CornerRadius" Value="5"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#12243F"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="4"/><Setter Property="MinHeight" Value="24"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0"/></Style>
 </UserControl.Resources>
 <Grid Margin="4,0,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2.5*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Execution overview" FontSize="29" FontWeight="Bold" Foreground="#0E1D35"/><TextBlock Text="Monitor suite executions, results and data quality across environments." Foreground="#617188" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="540"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Environment" VerticalAlignment="Center" Margin="0,0,9,0"/><Border BorderBrush="#CCD8E6" BorderThickness="1" Background="White" CornerRadius="4" Padding="12,8" MinWidth="120" Margin="0,0,12,0"><TextBlock Text="{Binding OverviewEnvironment}"/></Border><Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanEdit}" MinWidth="124" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="play" Width="17" Height="17" Margin="0,0,9,0"/><TextBlock Text="Run suite" FontWeight="SemiBold"/></StackPanel></Button></StackPanel>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,14">
   <Border Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#E4F0FF" CornerRadius="21" VerticalAlignment="Top"><local:StudioIcon Kind="suites" Width="22" Height="22" Foreground="#0870DF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Suites" Foreground="#53637A"/><TextBlock Text="{Binding OverviewSuiteCount}" FontSize="28" FontWeight="Bold" Foreground="#0B1930" Margin="0,2,0,0"/><TextBlock Text="Total test suites" Foreground="#7888A0" FontSize="12"/></StackPanel></Grid></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#E4F0FF" CornerRadius="21" VerticalAlignment="Top"><local:StudioIcon Kind="test" Width="22" Height="22" Foreground="#0870DF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Tests" Foreground="#53637A"/><TextBlock Text="{Binding OverviewTestCount}" FontSize="28" FontWeight="Bold" Foreground="#0B1930" Margin="0,2,0,0"/><TextBlock Text="Total test cases" Foreground="#7888A0" FontSize="12"/></StackPanel></Grid></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#E5F6EE" CornerRadius="21" VerticalAlignment="Top"><local:StudioIcon Kind="check" Width="22" Height="22" Foreground="#0A995C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Latest run" Foreground="#53637A"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding OverviewPassed}" Foreground="#07945B" FontSize="23" FontWeight="Bold"/><TextBlock Text=" passed / " VerticalAlignment="Bottom" Margin="3,0"/><TextBlock Text="{Binding OverviewFailed}" Foreground="#D52A2A" FontSize="23" FontWeight="Bold"/><TextBlock Text=" failed" VerticalAlignment="Bottom" Margin="3,0,0,0"/></StackPanel><TextBlock Text="{Binding OverviewLatestScope}" Foreground="#7888A0" FontSize="12"/></StackPanel></Grid></Border>
   <Border Style="{StaticResource Card}" Margin="0,0,12,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#E4F0FF" CornerRadius="21" VerticalAlignment="Top"><local:StudioIcon Kind="history" Width="22" Height="22" Foreground="#0870DF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Duration" Foreground="#53637A"/><TextBlock Text="{Binding OverviewDuration}" FontSize="28" FontWeight="Bold" Foreground="#0B1930" Margin="0,2,0,0"/><TextBlock Text="Latest execution" Foreground="#7888A0" FontSize="12"/></StackPanel></Grid></Border>
  </UniformGrid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="14,0"><Button DockPanel.Dock="Right" Content="View all runs  →" Command="{Binding ViewAllRunsCommand}" Style="{StaticResource Link}"/><TextBlock Text="Recent executions" Style="{StaticResource SectionTitle}"/></DockPanel><Grid Grid.Row="1"><DataGrid ItemsSource="{Binding OverviewRuns}" RowHeight="32" ColumnHeaderHeight="30"><DataGrid.Columns><DataGridTextColumn Header="Started at" Binding="{Binding Started}" Width="145"/><DataGridTextColumn Header="Suite" Binding="{Binding Suite}" Width="2*"/><DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="*"/><DataGridTemplateColumn Header="Status" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Passed" Binding="{Binding Passed}" Width="68"/><DataGridTextColumn Header="Failed" Binding="{Binding Failed}" Width="62"/><DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="85"/><DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="•••" ToolTip="Open run details" Style="{StaticResource Link}" Command="{Binding DataContext.OverviewOpenRunCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Text="No executions yet. Run a suite to see results here." Foreground="#708199" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OverviewRuns.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="14,0"><Button DockPanel.Dock="Right" Content="View all suites  →" Command="{Binding ViewAllSuitesCommand}" Style="{StaticResource Link}"/><TextBlock Text="Test suites" Style="{StaticResource SectionTitle}"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding OverviewSuites}" RowHeight="32" ColumnHeaderHeight="30"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Tests" Binding="{Binding Tests}" Width="52"/><DataGridTextColumn Header="Last run" Binding="{Binding LastRunAt}" Width="128"/><DataGridTemplateColumn Header="Status" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="•••" ToolTip="Open suite" Style="{StaticResource Link}" Command="{Binding DataContext.OverviewOpenSuiteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="14,0"><Button DockPanel.Dock="Right" Content="View all failures  →" Command="{Binding ViewAllFailuresCommand}" Style="{StaticResource Link}"/><TextBlock Text="Recent failure details" Style="{StaticResource SectionTitle}"/></DockPanel><Grid Grid.Row="1"><DataGrid ItemsSource="{Binding OverviewFailures}" RowHeight="36" ColumnHeaderHeight="30"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="115"/><DataGridTextColumn Header="Suite" Binding="{Binding Suite}" Width="*"/><DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/><DataGridTextColumn Header="Error message" Binding="{Binding Message}" Width="2*"/><DataGridTemplateColumn Width="38"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="•••" ToolTip="Open failure run" Style="{StaticResource Link}" Command="{Binding DataContext.OverviewOpenRunCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><TextBlock Text="No recent failures." Foreground="#708199" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OverviewFailures.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></Border>
  </Grid>
 </Grid>
</UserControl>
