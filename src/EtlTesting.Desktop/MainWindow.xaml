<Window x:Class="EtlTesting.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop" Title="ETL Test Studio · 0.3.7" Icon="{StaticResource StudioLogo}" Width="1580" Height="980" WindowState="Maximized" MinWidth="1180" MinHeight="740" Background="#F4F7FB" FontFamily="Segoe UI" FontSize="{DynamicResource StudioBodyFontSize}" Foreground="#102842" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

 <Grid>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#102842"><DockPanel>
<DockPanel DockPanel.Dock="Top" Margin="20,22,10,26"><local:StudioIcon Kind="database" Width="26" Height="28" Foreground="#39ABFF" Margin="0,0,10,0"/><TextBlock Text="{Binding ProductName}" Foreground="White" FontSize="16" VerticalAlignment="Center"/></DockPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="22,16,18,24"><TextBlock Text="LOCAL FIRST" FontSize="10" Foreground="#8DA6C1"/><TextBlock Text="Your data. Your network." Foreground="#B8C9DB" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="Release 0.3.7 · test library" Foreground="#8DA6C1" FontSize="10" Margin="0,6,0,0"/></StackPanel>
   <ListBox ItemsSource="{Binding Navigation}" SelectedIndex="{Binding Section}" Background="Transparent" BorderThickness="0" Foreground="#D7E5F4" Padding="8">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="{Binding Icon}" Width="22" Height="22" Margin="0,0,14,0"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,13"/><Setter Property="Margin" Value="0,3"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Nav" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#245285"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#1D3E62"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
   </ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="12,16,12,10">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,9"><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Section}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Section}" Value="2"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style><TextBlock Text="WORKSPACE   /   ETL VALIDATION" FontSize="10" Foreground="#62738A" VerticalAlignment="Center"/><Border Background="#FFF0C2" CornerRadius="12" Padding="12,5" HorizontalAlignment="Right"><TextBlock Text="{Binding ModeBadge}" FontSize="11" Foreground="#795500"/></Border></DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,11"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Section}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Section}" Value="2"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{Binding Heading}" FontWeight="Bold" Foreground="#101B2B"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="29"/><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="5"><Setter Property="FontSize" Value="24"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Subtitle}" Foreground="#62738A" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Section}" Value="2"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Section}" Value="3"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Section}" Value="5"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="Open suite" Command="{Binding OpenCommand}" IsEnabled="{Binding CanEdit}"/><Button Content="▶  Run suite" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Run suite"/></StackPanel>
   </Grid>
   <!-- Overview -->
   <local:OverviewView Grid.Row="2" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=0}"/>
   <!-- Suite designer -->
   <local:SuiteWorkspaceView Grid.Row="2"><local:SuiteWorkspaceView.Style><Style TargetType="local:SuiteWorkspaceView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=Window}}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:SuiteWorkspaceView.Style></local:SuiteWorkspaceView>
   <!-- Connections -->
   <local:ConnectionManagerView Grid.Row="2" DataContext="{Binding Connections}"><local:ConnectionManagerView.Style><Style TargetType="local:ConnectionManagerView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=Window}}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:ConnectionManagerView.Style></local:ConnectionManagerView>
<local:DatabaseWorkspaceView Grid.Row="2" DataContext="{Binding Connections}"><local:DatabaseWorkspaceView.Style><Style TargetType="local:DatabaseWorkspaceView"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Section,RelativeSource={RelativeSource AncestorType=Window}}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:DatabaseWorkspaceView.Style></local:DatabaseWorkspaceView>
   <!-- History / monitor -->
   <Grid Grid.Row="2" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=4}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><DockPanel><Button DockPanel.Dock="Right" Content="Cancel run" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/><StackPanel><TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold"/><ProgressBar Maximum="{Binding Total}" Value="{Binding Completed,Mode=OneWay}" Height="7" Margin="0,12,20,0"/></StackPanel></DockPanel></Border>
    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0"><DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"><DataGrid.Columns><DataGridTextColumn Header="Started" Binding="{Binding Started,StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"/><DataGridTextColumn Header="Suite" Binding="{Binding SuiteName}" Width="*"/><DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Run ID" Binding="{Binding RunId}" Width="220"/></DataGrid.Columns></DataGrid></Border>
    <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,16,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Live execution log" Style="{StaticResource Title}"/><TextBox Text="{Binding Logs,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="#F8FAFD"/></DockPanel></Border>
   </Grid>
   <!-- Reports -->
   <local:ReportView Grid.Row="2" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=5}"/>
   <!-- Settings -->
   <Border Grid.Row="2" Style="{StaticResource Panel}" Visibility="{Binding Section,Converter={StaticResource SectionVisibility},ConverterParameter=6}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Execution mode" Style="{StaticResource Title}"/><CheckBox Content="Use deterministic demo fixtures (no SQL queries)" IsChecked="{Binding IsDemo}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,18"/>
    <TextBlock Text="Runtime parameters · one name=value per line" Style="{StaticResource Label}"/><TextBox Text="{Binding ParametersText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90" VerticalContentAlignment="Top"/>
    <TextBlock Text="PowerShell command preview" Style="{StaticResource Label}"/><TextBox Text="{Binding CliCommand,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="#102842" Foreground="#D7E5F4" FontFamily="Consolas" Padding="16"/>
    <TextBlock Text="Exit codes" Style="{StaticResource Title}" Margin="0,26,0,14"/><TextBlock Text="0   All required checks passed (warning failures are non-blocking)&#x0a;1   Validation failures&#x0a;2   Configuration, execution or report-generation error&#x0a;3   Cancelled (partial results)" LineHeight="26"/>
    <TextBlock Text="Distribution &amp; team use" Style="{StaticResource Title}" Margin="0,26,0,14"/><TextBlock Text="Publish the desktop and CLI separately with scripts/publish.ps1. Suite JSON belongs in Git. Each teammate has local history under %LOCALAPPDATA%\EtlTestStudio. Share exported reports and suite files. See docs/deployment.md for runner setup and read-only SQL access." TextWrapping="Wrap" Foreground="#62738A"/>
    <TextBlock Text="Initial release" Style="{StaticResource Title}" Margin="0,26,0,14"/><TextBlock Text="Current execution supports exact comparisons and SQL assertions. Incremental workflows and automated checkpoint advancement are unavailable. Run comparisons against quiescent data after your ETL finishes; separate reads do not create a shared database snapshot." TextWrapping="Wrap" Foreground="#B96A00"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#DCE4EF" BorderThickness="0,1,0,0" Background="#EDF2F8" Padding="18,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding ConnectionStatus}" Foreground="#52677E" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Status}" FontSize="11" VerticalAlignment="Center"/><Button Command="{Binding RefreshOverviewCommand}" ToolTip="Refresh overview" Padding="4" MinHeight="22" Margin="12,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Section}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></Button.Style><local:StudioIcon Kind="refresh" Width="16" Height="16"/></Button></StackPanel></Grid></Border>
 </Grid>
</Window>




