<UserControl x:Class="EtlTesting.Desktop.ValidationTemplatePickerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop"><UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisible" /><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DAE4F1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /></Style><Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1265DB" /><Setter Property="BorderBrush" Value="#1265DB" /><Setter Property="Foreground" Value="White" /></Style></UserControl.Resources><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><Button Command="{Binding BackCommand}" DockPanel.Dock="Left" AutomationProperties.Name="Back to test"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="back" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Test" VerticalAlignment="Center"/></StackPanel></Button><StackPanel><TextBlock Text="Validation templates" FontSize="{DynamicResource StudioSuiteHeadingSize}" FontWeight="SemiBold" /><TextBlock Text="Choose checks, configure their rules, and add them to this test." Foreground="#667B95" Margin="0,5,0,0" /></StackPanel></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="200" x:Name="CategoryColumn" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" MinWidth="285" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.2*" MinWidth="340" /></Grid.ColumnDefinitions><local:TemplateCategoriesView Grid.Column="0"/><Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="16,16,16,8"><TextBlock Text="Available checks" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding BatchSummary}" Foreground="#008D7A" Margin="0,7,0,0" /><TabControl SelectedIndex="{Binding CatalogTab}" BorderThickness="0" Margin="0,8,0,0"><TabItem Header="All templates" /><TabItem Header="Recommended" /></TabControl></StackPanel><ListBox IsEnabled="{Binding CanInteract}" ItemsSource="{Binding BatchView}" SelectedItem="{Binding ActiveBatchItem}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="8,4" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderThickness="1" BorderBrush="#DFE8F4" CornerRadius="5" Padding="9,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions><CheckBox Click="OnSelectCheck" IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Available}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" /><StackPanel Grid.Column="1"><DockPanel><Border DockPanel.Dock="Right" Background="{Binding Tint}" Padding="5,2" CornerRadius="9" Margin="8,0,0,0"><TextBlock Text="{Binding Category}" Foreground="{Binding Accent}" FontSize="10" /></Border><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource StudioBodyFontSize}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /></DockPanel><TextBlock Text="{Binding Description}" Foreground="#6A7B92" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Description}" /></StackPanel><Ellipse Grid.Column="2" Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center" HorizontalAlignment="Right" ToolTip="{Binding Status}" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding ActiveBatchItem.Name,StringFormat='Configure: {0}',TargetNullValue=Choose a template}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveBatchItem.Status}" Foreground="#007E78" Margin="0,5,0,0" /></StackPanel></Border><Border Grid.Row="1" Style="{StaticResource Card}"><local:TemplateRuleView IsEnabled="{Binding ActiveBatchItem.Available}" /></Border><StackPanel Grid.Row="2" Margin="0,8,0,0"><WrapPanel><Button Command="{Binding ConfigureBatchCommand}" IsEnabled="{Binding ActiveBatchItem.Available}" Style="{StaticResource Primary}" Padding="10,6" AutomationProperties.Name="Mark configured"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="check" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Mark configured" VerticalAlignment="Center"/></StackPanel></Button><Button Command="{Binding PreviewValidationCommand}" IsEnabled="{Binding ActiveBatchItem.Available}" Padding="10,6" AutomationProperties.Name="Preview check"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="play" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Preview check" VerticalAlignment="Center"/></StackPanel></Button><Button Content="•••" ToolTip="More actions" Click="OnMoreActions" Padding="8,6"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><MenuItem Header="Show generated SQL" Command="{Binding ShowSqlCommand}" IsEnabled="{Binding ActiveBatchItem.Available}"/><MenuItem Header="Cancel preview" Command="{Binding CancelCommand}" IsEnabled="{Binding IsWorking}"/></ContextMenu></Button.ContextMenu></Button></WrapPanel><TextBlock Text="{Binding PreviewMessage}" Visibility="{Binding HasPreview,Converter={StaticResource BoolVisible}}" Foreground="#54708A" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/></StackPanel></Grid></Grid><Border Grid.Row="2" Background="#EAF2FD" CornerRadius="7" Padding="13" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Command="{Binding BackCommand}" AutomationProperties.Name="Cancel"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="close" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Cancel" VerticalAlignment="Center"/></StackPanel></Button><Button Command="{Binding SaveBatchPresetCommand}" IsEnabled="{Binding CanAddBatch}" AutomationProperties.Name="Save as preset…"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="save" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Save as preset…" VerticalAlignment="Center"/></StackPanel></Button><Button Command="{Binding AddBatchCommand}" IsEnabled="{Binding CanAddBatch}" Style="{StaticResource Primary}" AutomationProperties.Name="{Binding AddBatchLabel}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="plus" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="{Binding AddBatchLabel}" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><TextBlock Text="{Binding BatchSummary}" Foreground="#946412" VerticalAlignment="Center" /></DockPanel></Border></Grid></UserControl>