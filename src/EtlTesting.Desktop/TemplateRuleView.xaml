 <Expander Header="Suite parameters" Margin="0,6,0,14" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel Margin="0,10"><TextBlock Text="These declarations are shared by the suite. Runtime overrides remain in Settings. Use @parameterName in filters and SQL." Style="{StaticResource Hint}" /><DataGrid ItemsSource="{Binding Parameters}" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True" Height="140" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="*" /><DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type,UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static local:SuiteDesignerViewModel.ParameterTypes}" Width="150" /><DataGridCheckBoxColumn Header="Required" Binding="{Binding Required,UpdateSourceTrigger=PropertyChanged}" Width="85" /><DataGridTextColumn Header="Default value" Binding="{Binding DefaultValue,UpdateSourceTrigger=PropertyChanged}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Expander>
 <Expander Header="Generated SQL" IsExpanded="{Binding HasGeneratedSql,Mode=OneWay}"><TextBox Text="{Binding GeneratedSql,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto"/></Expander>
 <Expander Header="Preview results" IsExpanded="{Binding HasPreview,Mode=OneWay}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><StackPanel Margin="0,10"><TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource Hint}" /><TabControl ItemsSource="{Binding Previews}" SelectedItem="{Binding SelectedPreview}" Margin="0,10"><TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></TabControl.ItemTemplate><TabControl.ContentTemplate><DataTemplate><DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Height="200" /></DataTemplate></TabControl.ContentTemplate></TabControl><DataGrid ItemsSource="{Binding PreviewEvidence}" Height="180"><DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" /><DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="*" /><DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="140" /><DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="140" /><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Expander>
</StackPanel></ScrollViewer></UserControl>