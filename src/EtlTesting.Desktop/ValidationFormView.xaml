<UserControl x:Class="EtlTesting.Desktop.ValidationFormView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisible"/>
  <local:SectionVisibilityConverter x:Key="StageVisible"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE4EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="Field" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#53677F"/><Setter Property="Margin" Value="0,9,0,5"/></Style>
  <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#65778E"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
  <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0067D9"/><Setter Property="BorderBrush" Value="#0067D9"/><Setter Property="Foreground" Value="White"/></Style>
  <DataTemplate x:Key="SourceColumnEditor"><ComboBox ItemsSource="{Binding DataContext.SourceColumns,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" IsEditable="True" Text="{Binding Source,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
  <DataTemplate x:Key="TargetColumnEditor"><ComboBox ItemsSource="{Binding DataContext.TargetColumns,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" IsEditable="True" Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
  <DataTemplate x:Key="SourceColumnDisplay"><TextBlock Text="{Binding Source}" VerticalAlignment="Center"/></DataTemplate>
  <DataTemplate x:Key="TargetColumnDisplay"><TextBlock Text="{Binding Target}" VerticalAlignment="Center"/></DataTemplate>
 </UserControl.Resources>
   <Border Style="{StaticResource Card}" Padding="0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,14,20,20" IsEnabled="{Binding CanInteract}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Validation name" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Validation name"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Connection profile / logical key" Style="{StaticResource Field}"/><ComboBox ItemsSource="{Binding ConnectionNames}" IsEditable="True" Text="{Binding Editor.Connection,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Validation connection"/></StackPanel></Grid>
    <DockPanel Margin="0,12,0,12"><CheckBox DockPanel.Dock="Left" Content="Validation enabled" IsChecked="{Binding Editor.Enabled}" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Load tables &amp; columns" Command="{Binding LoadMetadataCommand}" Visibility="{Binding Editor.HasScope,Converter={StaticResource BoolVisible}}"/><TextBlock Text="{Binding Editor.Id}" FontFamily="Consolas" FontSize="10" Foreground="#8796A8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0"/></DockPanel>
    <Grid Visibility="{Binding Editor.HasScope,Converter={StaticResource BoolVisible}}" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Background="#F8FAFD"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Grid.ColumnSpan" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding Editor.HasTarget}" Value="False"><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding Editor.ScopeTitle}" Style="{StaticResource SectionHeading}"/>
      <StackPanel Visibility="{Binding Editor.IsComparison,Converter={StaticResource BoolVisible}}"><TextBlock Text="Connection override (empty inherits profile)" Style="{StaticResource Field}"/><ComboBox ItemsSource="{Binding ConnectionNames}" IsEditable="True" Text="{Binding Editor.SourceConnection,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Schema" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.SourceSchema,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Table / view" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.SourceTable,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
      <ComboBox ItemsSource="{Binding SourceObjects}" DisplayMemberPath="QualifiedName" SelectedItem="{Binding Editor.SourceObject}" Margin="0,10,0,0" ToolTip="Choose a table after loading metadata"/>
      <TextBlock Text="Scope filter (SQL; suite parameters supported)" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.SourceFilter,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"/>
     </StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Background="#F8FAFD" Visibility="{Binding Editor.HasTarget,Converter={StaticResource BoolVisible}}"><StackPanel><TextBlock Text="{Binding Editor.TargetTitle}" Style="{StaticResource SectionHeading}"/>
      <StackPanel Visibility="{Binding Editor.IsComparison,Converter={StaticResource BoolVisible}}"><TextBlock Text="Connection override (empty inherits profile)" Style="{StaticResource Field}"/><ComboBox ItemsSource="{Binding ConnectionNames}" IsEditable="True" Text="{Binding Editor.TargetConnection,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Schema" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.TargetSchema,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Table / view" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.TargetTable,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
      <ComboBox ItemsSource="{Binding TargetObjects}" DisplayMemberPath="QualifiedName" SelectedItem="{Binding Editor.TargetObject}" Margin="0,10,0,0" ToolTip="Choose a target after loading metadata"/>
      <TextBlock Text="Scope filter (SQL; suite parameters supported)" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.TargetFilter,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"/>
     </StackPanel></Border>
    </Grid>
    <!-- Each template exposes only its applicable rule configuration. -->
    <StackPanel Visibility="{Binding Editor.HasColumnList,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><TextBlock Text="Columns to validate" Style="{StaticResource SectionHeading}"/><TextBlock Text="Choose loaded columns, or enter one exact column name per line." Style="{StaticResource Hint}"/>
     <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Editor.ColumnText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="120" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Validation columns, one per line"/><ScrollViewer Grid.Column="2" Height="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ColumnOptions}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="3,5"><CheckBox DockPanel.Dock="Left" IsChecked="{Binding Selected,UpdateSourceTrigger=PropertyChanged}" Content="{Binding Name}"/><TextBlock Text="{Binding Type}" Foreground="#8796A8" FontSize="11" HorizontalAlignment="Right" Margin="10,0,0,0"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
     <StackPanel Orientation="Horizontal"><Button Content="Select all loaded columns" Command="{Binding SelectAllColumnsCommand}" Style="{StaticResource CompactButton}"/><Button Content="Clear" Command="{Binding ClearColumnsCommand}" Style="{StaticResource CompactButton}"/></StackPanel>
    </StackPanel>
    <StackPanel Visibility="{Binding Editor.IsRequired,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><CheckBox Content="Also reject empty and whitespace strings" IsChecked="{Binding Editor.CheckWhitespace}"/><TextBlock Text="Null values always fail this rule. Each violating row is counted once, even if several selected columns are invalid." Style="{StaticResource Hint}"/></StackPanel>
    <StackPanel Visibility="{Binding Editor.HasSingleColumn,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><TextBlock Text="Column" Style="{StaticResource SectionHeading}"/><ComboBox ItemsSource="{Binding SourceColumns}" DisplayMemberPath="Name" IsEditable="True" Text="{Binding Editor.SingleColumn,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rule column"/></StackPanel>
    <StackPanel Visibility="{Binding Editor.IsAllowed,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Value type" Style="{StaticResource Field}"/><ComboBox ItemsSource="{x:Static local:SuiteDesignerViewModel.ParameterTypes}" SelectedItem="{Binding Editor.ValueType}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Allowed values (one per line)" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.AllowedValues,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="115" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></StackPanel></Grid><CheckBox Content="Allow an empty string" IsChecked="{Binding Editor.AllowEmptyString}" Visibility="{Binding Editor.IsStringValue,Converter={StaticResource BoolVisible}}" Margin="0,10,0,0"/><TextBlock Text="Values are bound as typed SQL parameters. String membership uses the database collation." Style="{StaticResource Hint}"/></StackPanel>
    <StackPanel Visibility="{Binding Editor.IsRange,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><TextBlock Text="Range boundaries" Style="{StaticResource SectionHeading}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Lower boundary" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.Minimum,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Include lower boundary" IsChecked="{Binding Editor.IncludeMinimum}" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Upper boundary" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.Maximum,UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Include upper boundary" IsChecked="{Binding Editor.IncludeMaximum}" Margin="0,8,0,0"/></StackPanel></Grid><TextBlock Text="{Binding Editor.RangeHelp}" Style="{StaticResource Hint}"/></StackPanel>
    <StackPanel Visibility="{Binding Editor.HasKeys,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><TextBlock Text="{Binding Editor.KeyTitle}" Style="{StaticResource SectionHeading}"/><DataGrid ItemsSource="{Binding Editor.Keys}" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True" Height="145"><DataGrid.Columns>
     <DataGridTemplateColumn Header="Source / child column" Width="*" CellTemplate="{StaticResource SourceColumnDisplay}" CellEditingTemplate="{StaticResource SourceColumnEditor}"/>
     <DataGridTemplateColumn Header="Target / parent column" Width="*" CellTemplate="{StaticResource TargetColumnDisplay}" CellEditingTemplate="{StaticResource TargetColumnEditor}"/>
    </DataGrid.Columns></DataGrid><TextBlock Text="Use the last row to add a mapping. Select a row and press Delete to remove it." Style="{StaticResource Hint}"/></StackPanel>
    <StackPanel Visibility="{Binding Editor.IsComparison,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><TextBlock Text="Column comparison rules" Style="{StaticResource SectionHeading}"/><DataGrid ItemsSource="{Binding Editor.Mappings}" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True" Height="210"><DataGrid.Columns>
     <DataGridTemplateColumn Header="Source" Width="*" MinWidth="130" CellTemplate="{StaticResource SourceColumnDisplay}" CellEditingTemplate="{StaticResource SourceColumnEditor}"/>
     <DataGridTemplateColumn Header="Target" Width="*" MinWidth="130" CellTemplate="{StaticResource TargetColumnDisplay}" CellEditingTemplate="{StaticResource TargetColumnEditor}"/>
     <DataGridCheckBoxColumn Header="Trim" Binding="{Binding Trim,UpdateSourceTrigger=PropertyChanged}" Width="55"/><DataGridCheckBoxColumn Header="Ignore case" Binding="{Binding IgnoreCase,UpdateSourceTrigger=PropertyChanged}" Width="90"/><DataGridCheckBoxColumn Header="Empty = null" Binding="{Binding EmptyAsNull,UpdateSourceTrigger=PropertyChanged}" Width="95"/><DataGridTextColumn Header="Decimal ±" Binding="{Binding Tolerance,UpdateSourceTrigger=PropertyChanged}" Width="95"/><DataGridTextColumn Header="Date ± ms" Binding="{Binding DateTolerance,UpdateSourceTrigger=PropertyChanged}" Width="95"/>
    </DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" Margin="0,12"><CheckBox Content="Detect missing target rows" IsChecked="{Binding Editor.MissingRows}" Margin="0,0,20,0"/><CheckBox Content="Detect unexpected target rows" IsChecked="{Binding Editor.UnexpectedRows}"/></StackPanel><TextBlock Text="Key uniqueness and null business keys are always checked. Ambiguous duplicates are excluded from value matching." Style="{StaticResource Hint}"/></StackPanel>
    <StackPanel Visibility="{Binding Editor.IsAggregate,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><TextBlock Text="Aggregate measures" Style="{StaticResource SectionHeading}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Function" Style="{StaticResource Field}"/><ComboBox SelectedValue="{Binding Editor.Aggregate}" SelectedValuePath="Tag"><ComboBoxItem Content="Sum" Tag="sum"/><ComboBoxItem Content="Count rows" Tag="count"/><ComboBoxItem Content="Minimum" Tag="min"/><ComboBoxItem Content="Maximum" Tag="max"/></ComboBox></StackPanel><StackPanel Grid.Column="2" Visibility="{Binding Editor.NeedsMeasure,Converter={StaticResource BoolVisible}}"><TextBlock Text="Source numeric column" Style="{StaticResource Field}"/><ComboBox ItemsSource="{Binding SourceColumns}" DisplayMemberPath="Name" IsEditable="True" Text="{Binding Editor.SourceMeasure,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="4" Visibility="{Binding Editor.NeedsMeasure,Converter={StaticResource BoolVisible}}"><TextBlock Text="Target numeric column" Style="{StaticResource Field}"/><ComboBox ItemsSource="{Binding TargetColumns}" DisplayMemberPath="Name" IsEditable="True" Text="{Binding Editor.TargetMeasure,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="Leave grouping keys empty to reconcile grand totals. Groups present on only one side fail." Style="{StaticResource Hint}"/></StackPanel>
    <StackPanel Visibility="{Binding Editor.HasTolerance,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><TextBlock Text="Absolute reconciliation tolerance" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.Tolerance,UpdateSourceTrigger=PropertyChanged}" MaxWidth="220" HorizontalAlignment="Left" MinWidth="180"/><TextBlock Text="Source and target scopes use the selected connection. Zero requires exact totals." Style="{StaticResource Hint}"/></StackPanel>
    <CheckBox Visibility="{Binding Editor.HasNullPolicy,Converter={StaticResource BoolVisible}}" Content="Fail when a selected value or key component is null" IsChecked="{Binding Editor.FailOnNull}" Margin="0,0,0,16"/>
    <StackPanel Visibility="{Binding Editor.IsSql,Converter={StaticResource BoolVisible}}" Margin="0,0,0,16"><TextBlock Text="SQL assertion" Style="{StaticResource SectionHeading}"/><TextBox Text="{Binding Editor.Query,UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Code,Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True" Height="245" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Validation SQL editor"/>
     <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Expectation" Style="{StaticResource Field}"/><ComboBox SelectedValue="{Binding Editor.ExpectationMode}" SelectedValuePath="Tag"><ComboBoxItem Content="Zero violating rows" Tag="zero"/><ComboBoxItem Content="Exact returned row count" Tag="rowCount"/><ComboBoxItem Content="Typed scalar value" Tag="scalar"/></ComboBox></StackPanel><StackPanel Grid.Column="2" Visibility="{Binding Editor.UseRowCount,Converter={StaticResource BoolVisible}}"><TextBlock Text="Expected row count" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.RowCount,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
     <Grid Visibility="{Binding Editor.UseScalar,Converter={StaticResource BoolVisible}}"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Scalar type" Style="{StaticResource Field}"/><ComboBox SelectedValue="{Binding Editor.ScalarKind}" SelectedValuePath="Tag"><ComboBoxItem Content="String" Tag="string"/><ComboBoxItem Content="Decimal / integer" Tag="decimal"/><ComboBoxItem Content="Boolean" Tag="boolean"/><ComboBoxItem Content="Datetime" Tag="datetime"/><ComboBoxItem Content="Datetime with offset" Tag="datetimeoffset"/><ComboBoxItem Content="GUID" Tag="guid"/><ComboBoxItem Content="Binary (base64)" Tag="binary"/><ComboBoxItem Content="Null" Tag="null"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Expected typed value" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.ScalarValue,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="The query executes once. Scalar expectations require exactly one row and one column." Style="{StaticResource Hint}"/>
    </StackPanel>
    <Expander Header="Suite parameters" Margin="0,6,0,14"><StackPanel Margin="0,10"><TextBlock Text="These declarations are shared by the suite. Runtime overrides remain in Settings. Use @parameterName in filters and SQL." Style="{StaticResource Hint}"/><DataGrid ItemsSource="{Binding Parameters}" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True" Height="140" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type,UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static local:SuiteDesignerViewModel.ParameterTypes}" Width="150"/><DataGridCheckBoxColumn Header="Required" Binding="{Binding Required,UpdateSourceTrigger=PropertyChanged}" Width="85"/><DataGridTextColumn Header="Default value" Binding="{Binding DefaultValue,UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
    <Expander Header="Execution &amp; evidence settings" Margin="0,4,0,14"><StackPanel Margin="0,10"><UniformGrid Columns="3"><StackPanel Margin="0,0,12,0"><TextBlock Text="Severity" Style="{StaticResource Field}"/><ComboBox SelectedValue="{Binding Editor.Severity}" SelectedValuePath="Tag"><ComboBoxItem Content="Error · blocks success" Tag="error"/><ComboBoxItem Content="Warning · non-blocking" Tag="warning"/></ComboBox></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Evidence limit (0–10,000)" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.EvidenceLimit,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="Timeout seconds (empty inherits suite)" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.Timeout,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tags (comma separated)" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.Tags,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2" Visibility="{Binding Editor.IsRecipe,Converter={StaticResource BoolVisible}}"><TextBlock Text="Allowed violating rows / groups" Style="{StaticResource Field}"/><TextBox Text="{Binding Editor.AllowedViolations,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="Evidence limits affect retained examples only. All rows within the configured scope are validated. SQL template equality uses the database collation." Style="{StaticResource Hint}"/></StackPanel></Expander>
    <Expander Header="Generated SQL / execution details" IsExpanded="{Binding HasGeneratedSql,Mode=OneWay}" Margin="0,4,0,14"><TextBox Text="{Binding GeneratedSql,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="200" Margin="0,10,0,0"/></Expander>
    <Expander Header="Preview results" IsExpanded="{Binding HasPreview,Mode=OneWay}"><StackPanel Margin="0,10"><TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource Hint}"/><TabControl ItemsSource="{Binding Previews}" SelectedItem="{Binding SelectedPreview}" Margin="0,10"><TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></TabControl.ItemTemplate><TabControl.ContentTemplate><DataTemplate><DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" Height="200"/></DataTemplate></TabControl.ContentTemplate></TabControl><DataGrid ItemsSource="{Binding PreviewEvidence}" Height="180"><DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/><DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="*"/><DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="140"/><DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="140"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
   </StackPanel></ScrollViewer></Border>
</UserControl>