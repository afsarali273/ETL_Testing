<UserControl x:Class="EtlTesting.Desktop.SuiteWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop" IsVisibleChanged="OnVisibleChanged">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/><local:SectionVisibilityConverter x:Key="StageVisible"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DBE5F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1568DB"/><Setter Property="BorderBrush" Value="#1568DB"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Icon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="23"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid Visibility="{Binding ShowingLibrary,Converter={StaticResource Visible}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border CornerRadius="12" Padding="24,22" Margin="0,0,0,16"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#113660" Offset="0"/><GradientStop Color="#166D8D" Offset="1"/></LinearGradientBrush></Border.Background><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding ImportSuitesCommand}" AutomationProperties.Name="Import files…"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="file" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Import files…" VerticalAlignment="Center"/></StackPanel></Button><Button Command="{Binding ImportSuiteFolderCommand}" AutomationProperties.Name="Import folder…"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="folder" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Import folder…" VerticalAlignment="Center"/></StackPanel></Button><Button Command="{Binding NewSuiteCommand}" Style="{StaticResource Primary}" AutomationProperties.Name="New suite"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="plus" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="New suite" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><StackPanel><TextBlock Text="YOUR TEST LIBRARY" Foreground="#91DBEA" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Every pipeline. Every check." Foreground="White" FontSize="{DynamicResource StudioSuiteHeadingSize}" FontWeight="SemiBold" Margin="0,7,0,6"/><TextBlock Text="{Binding LibrarySummary}" Foreground="#D0E5F1" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
   <DockPanel Grid.Row="1" Margin="0,0,0,16"><Button DockPanel.Dock="Right" Command="{Binding RefreshLibraryCommand}" AutomationProperties.Name="Refresh library"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="refresh" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Refresh library" VerticalAlignment="Center"/></StackPanel></Button><TextBox Text="{Binding SuiteSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search suites" ToolTip="Search suites by name, description or connection" MaxWidth="520" HorizontalAlignment="Left" MinWidth="330"/></DockPanel>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding SuiteCardsView}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="350" MinHeight="235" Margin="0,0,16,16" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="6"/><RowDefinition/></Grid.RowDefinitions><Border Background="{Binding Accent}" CornerRadius="8,8,0,0"/><StackPanel Grid.Row="1" Margin="20,18"><DockPanel><Border DockPanel.Dock="Right" Background="#F0F4FB" CornerRadius="9" Padding="8,4"><TextBlock Text="{Binding Origin}" Foreground="{Binding Accent}" FontSize="9" FontWeight="SemiBold"/></Border><local:StudioIcon Kind="suites" Width="28" Height="28" Foreground="{Binding Accent}"/></DockPanel><TextBlock Text="{Binding Name}" FontSize="{DynamicResource StudioCaseHeadingSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,15,0,8" ToolTip="{Binding FilePath}"/><TextBlock Text="{Binding Description}" Foreground="#6B7E95" TextWrapping="Wrap" MaxHeight="36" FontSize="12"/><TextBlock Text="{Binding Counts}" Foreground="{Binding Accent}" Margin="0,15,0,9" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Command="{Binding DataContext.OpenLibrarySuiteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Open suite"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="arrow" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Open suite" VerticalAlignment="Center"/></StackPanel></Button><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:StudioIcon Kind="database" Width="15" Height="16" Foreground="#8395A9" Margin="0,0,6,0"/><TextBlock Text="{Binding Connection}" Foreground="#687B91" FontSize="11" MaxWidth="140" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock Grid.Row="3" Text="{Binding LibraryMessage}" Foreground="#617891" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </Grid>
  <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding ShowingLibrary}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <Grid Margin="4,0,0,14" Visibility="{Binding Designer.Stage,Converter={StaticResource StageVisible},ConverterParameter=0}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="{DynamicResource StudioSuiteHeadingSize}" FontWeight="SemiBold" Text="{Binding SuiteName}" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button Command="{Binding BackToLibraryCommand}" Padding="0" BorderBrush="Transparent" Background="Transparent" Foreground="#697B94" MinHeight="24" AutomationProperties.Name="Test Suites"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="suites" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Test Suites" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Text="  ›  Suite designer" Foreground="#697B94" VerticalAlignment="Center"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}"><Button Content="•••" ToolTip="Suite actions" Click="OnSuiteMenu" Padding="7"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><MenuItem Header="Edit suite details" Command="{Binding RenameSuiteCommand}"/><MenuItem Header="Duplicate suite" Command="{Binding DuplicateSuiteCommand}"/><MenuItem Header="Run selected test" Command="{Binding RunTestCaseCommand}"/><MenuItem Header="Edit suite JSON" Command="{Binding Designer.JsonCommand}"/></ContextMenu></Button.ContextMenu></Button><StackPanel Margin="0,0,18,0"><TextBlock Text="Environment" FontSize="12" Foreground="#63758C" Margin="0,0,0,5"/><TextBlock Text="{Binding ModeBadge}" FontSize="{DynamicResource StudioBodyFontSize}" MinWidth="110"/></StackPanel><Button Command="{Binding SaveCommand}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="save" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="Save"/></StackPanel></Button><Button Command="{Binding ValidateCommand}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="check" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="Validate"/></StackPanel></Button><Button Command="{Binding RunCommand}" Style="{StaticResource Primary}"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="play" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="Run suite"/></StackPanel></Button></StackPanel></Grid>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Width="{DynamicResource StudioTestRailWidth}" Padding="12" Margin="0,0,10,0" Visibility="{Binding Designer.Stage,Converter={StaticResource StageVisible},ConverterParameter=0}"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Command="{Binding AddTestCaseCommand}" AutomationProperties.Name="Test"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="plus" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Test" VerticalAlignment="Center"/></StackPanel></Button><TextBlock Text="Tests in this suite" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></StackPanel><Expander DockPanel.Dock="Bottom" Header="Test details" Margin="0,12,0,0"><StackPanel><TextBlock Text="TEST DETAILS" Foreground="#8090A6" FontSize="10" Margin="0,12,0,6"/><TextBox Text="{Binding TestCaseName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Test name"/><TextBox Text="{Binding TestCaseDescription,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="62" Margin="0,8,0,8" VerticalContentAlignment="Top" AutomationProperties.Name="Test description"/><WrapPanel><Button Command="{Binding SaveTestCaseCommand}" AutomationProperties.Name="Update"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="save" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Update" VerticalAlignment="Center"/></StackPanel></Button><Button Command="{Binding DuplicateTestCaseCommand}" AutomationProperties.Name="Copy"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="copy" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Copy" VerticalAlignment="Center"/></StackPanel></Button><Button Command="{Binding DeleteTestCaseCommand}" Foreground="#BD443E" AutomationProperties.Name="Delete"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="delete" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel></Button></WrapPanel></StackPanel></Expander><ListBox ItemsSource="{Binding TestCases}" SelectedItem="{Binding SelectedTestCase}" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,10"/><Setter Property="Margin" Value="0,4"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><local:StudioIcon Kind="database" Width="26" Height="29" Foreground="#6381A7" Margin="0,0,12,0" VerticalAlignment="Top"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Details}" Foreground="#71839A" FontSize="11" Margin="0,8,0,5"/><TextBlock Text="{Binding State}" Foreground="#008E7E" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    <local:SuiteDesignerView Grid.Column="1" DataContext="{Binding Designer}"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
