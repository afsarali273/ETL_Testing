<UserControl x:Class="EtlTesting.Desktop.TemplateCategoriesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop">
 <Border Background="White" BorderBrush="#DAE4F1" BorderThickness="1" CornerRadius="8" Padding="11">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Categories" FontSize="15" FontWeight="SemiBold" Foreground="#172C48" Margin="3,2,0,10"/>
   <Grid Grid.Row="1" Margin="0,0,0,9">
    <TextBox x:Name="SearchBox" Text="{Binding BatchSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search validation templates" ToolTip="Search validation templates" Padding="27,5,5,5" MinHeight="32"/>
    <local:StudioIcon Kind="search" Width="15" Height="15" Foreground="#7589A3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
    <TextBlock Text="Search templates" Foreground="#8292A8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="27,0,0,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers><Setter Property="Visibility" Value="Collapsed"/></Style></TextBlock.Style></TextBlock>
   </Grid>
   <ListBox Grid.Row="2" ItemsSource="{Binding BatchCategories}" SelectedValuePath="Name" SelectedValue="{Binding BatchCategory}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" MinHeight="120">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="30"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryRow" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="5,2"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryRow" Property="Background" Value="#E4F0FF"/><Setter TargetName="CategoryRow" Property="BorderBrush" Value="#BED8FB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryRow" Property="Background" Value="#F0F6FD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="6" Background="{Binding Tint}" VerticalAlignment="Center"><local:StudioIcon Kind="{Binding Icon}" Width="14" Height="14" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource StudioBodyFontSize}" VerticalAlignment="Center" Foreground="#17304C" TextTrimming="CharacterEllipsis" Margin="7,0,3,0" ToolTip="{Binding Name}"/><Border Grid.Column="2" Background="#EEF3FA" CornerRadius="9" Padding="5,2" VerticalAlignment="Center"><TextBlock Text="{Binding Count}" FontSize="11" Foreground="#627994"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Expander x:Name="ContextExpander" Grid.Row="3" Header="Suite context" FontSize="11" Foreground="#6A7E96" Margin="0,7,0,0" IsExpanded="True"><Border Background="#F5F8FC" BorderBrush="#E5EBF3" BorderThickness="1" CornerRadius="6" Padding="9,5"><StackPanel><TextBlock Text="{Binding SuiteName}" FontSize="12" FontWeight="SemiBold" Foreground="#213B5A" TextTrimming="CharacterEllipsis" ToolTip="{Binding SuiteName}"/><TextBlock Text="{Binding SuiteContext}" Foreground="#6A7E96" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding SuiteContext}"/></StackPanel></Border></Expander>
  </Grid>
 </Border>
</UserControl>
