<UserControl x:Class="EtlTesting.Desktop.DatabaseWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE4EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#142D49"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#708198"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD8E6"/></Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Padding="15,12" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Connection" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
   <ComboBox Grid.Column="1" ItemsSource="{Binding SavedProfiles}" SelectedItem="{Binding WorkspaceProfile}" IsEnabled="{Binding CanInteract}" AutomationProperties.Name="SQL workspace connection profile"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Saved.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Saved.EnvironmentName}" FontSize="10" Foreground="#708198"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
   <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding WorkspaceDatabase}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding WorkspaceServer}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
   <Button Grid.Column="4" Content="↻  Load tables" Command="{Binding LoadObjectsCommand}" IsEnabled="{Binding CanInteract}" Style="{StaticResource SmallButton}" Margin="12,0,0,0"/>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="190"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="15,18,15,12"><TextBlock Text="Database explorer" Style="{StaticResource SectionHeading}"/><TextBlock Text="Tables &amp; views" Style="{StaticResource Hint}"/><TextBox Text="{Binding ObjectSearch,UpdateSourceTrigger=PropertyChanged}" Margin="0,11,0,0" ToolTip="Search table, view or schema name" AutomationProperties.Name="Search database objects"/></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding ObjectsView}" SelectedItem="{Binding SelectedObject}" IsEnabled="{Binding CanInteract}" Background="White" BorderThickness="0" Margin="6,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,9"><TextBlock Text="{Binding QualifiedName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="#708198" FontSize="10" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="2" BorderBrush="#E7EDF5" BorderThickness="0,1,0,0" Padding="15,12"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Objects.Count}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text=" visible objects" FontSize="11" Foreground="#708198"/></StackPanel><TextBlock Text="Choose a saved profile, load tables, then select an object to preview it." Style="{StaticResource Hint}"/></StackPanel></Border>
   </Grid></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,4,12,12"><TabControl SelectedIndex="{Binding WorkspaceTab}" IsEnabled="{Binding HasWorkspaceProfile}" BorderThickness="0" Background="White">
    <TabItem Header="SQL editor"><Grid Margin="4,16,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="160" MinHeight="80"/><RowDefinition Height="8"/><RowDefinition MinHeight="80"/><RowDefinition Height="70"/></Grid.RowDefinitions>
      <DockPanel><StackPanel><TextBlock Text="SQL query editor" Style="{StaticResource SectionHeading}"/><TextBlock Text="{Binding WorkspaceDatabase}" Style="{StaticResource Hint}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding CanInteract}"><Button Content="Open .sql" Command="{Binding OpenSqlCommand}" Style="{StaticResource SmallButton}"/><Button Content="Save .sql" Command="{Binding SaveSqlCommand}" Style="{StaticResource SmallButton}" Margin="0"/></StackPanel></DockPanel>
      <WrapPanel Grid.Row="1" Margin="0,12,0,10" IsEnabled="{Binding CanInteract}"><Button Content="▶  Execute SQL  F5" Command="{Binding ExecuteSqlCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="Rows" VerticalAlignment="Center" Margin="10,0,8,0" Foreground="#62738A"/><ComboBox ItemsSource="{Binding RowLimits}" Text="{Binding ResultLimit,UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Width="80"/><TextBlock Text="Timeout (s)" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="#62738A"/><TextBox Text="{Binding QueryTimeout,UpdateSourceTrigger=PropertyChanged}" Width="65"/></WrapPanel>
      <TextBox Grid.Row="2" Text="{Binding QueryText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Code,Consolas" FontSize="13" Background="#11283F" Foreground="#E3EFFB" CaretBrush="White" BorderThickness="0" Padding="15" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="{Binding IsWorking}" AutomationProperties.Name="SQL query editor"><TextBox.InputBindings><KeyBinding Key="F5" Command="{Binding ExecuteSqlCommand}"/><KeyBinding Key="Return" Modifiers="Control" Command="{Binding ExecuteSqlCommand}"/></TextBox.InputBindings></TextBox>
      <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Results" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox ItemsSource="{Binding SqlResults}" SelectedItem="{Binding SelectedSqlResult}" DisplayMemberPath="Label" MinWidth="180" MaxWidth="300" HorizontalAlignment="Left"/><TextBlock Text="Ctrl+C copies selected cells" Foreground="#8493A5" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><DataGrid Grid.Row="1" ItemsSource="{Binding SelectedSqlResult.View}" AutoGenerateColumns="True" AutoGeneratingColumn="PreviewColumnGenerating" ClipboardCopyMode="IncludeHeader" SelectionUnit="CellOrRowHeader" BorderBrush="#E1E8F1" BorderThickness="1"/></Grid>
      <TextBox Grid.Row="5" Text="{Binding QueryMessage,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Background="#F7F9FC" BorderThickness="0" Margin="0,10,0,0" ToolTip="SQL uses this profile's database permissions. A result cap cancels remaining rows and statements; earlier statements may have executed."/>
     </Grid></TabItem>
    <TabItem Header="Table data"><Grid Margin="4,16,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Open in SQL editor" Command="{Binding QueryObjectCommand}" IsEnabled="{Binding CanInteract}" Style="{StaticResource SmallButton}" Margin="0"/><TextBlock Text="{Binding SelectedObject.QualifiedName,TargetNullValue=Select an object from the explorer}" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Preview}" AutoGenerateColumns="True" AutoGeneratingColumn="PreviewColumnGenerating" ClipboardCopyMode="IncludeHeader" SelectionUnit="CellOrRowHeader" BorderBrush="#E1E8F1" BorderThickness="1"/>
     <DockPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanInteract}"><Button Content="← Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource SmallButton}"/><Button Content="Next →" Command="{Binding NextPageCommand}" Style="{StaticResource SmallButton}" Margin="0"/></StackPanel><TextBlock Text="{Binding PageLabel}" Foreground="#62738A" FontSize="10" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Grid.Row="3" Text="{Binding BrowserMessage}" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
    </Grid></TabItem>
    <TabItem Header="Columns"><Grid Margin="4,16,4,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding SelectedObject.QualifiedName,TargetNullValue=Select a table or view to inspect its columns}" Style="{StaticResource SectionHeading}" Margin="0,0,0,14"/><DataGrid Grid.Row="1" ItemsSource="{Binding Columns}"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Ordinal}" Width="45"/><DataGridTextColumn Header="Column name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="SQL type" Binding="{Binding SqlType}" Width="150"/><DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable,Mode=OneWay}" Width="75"/><DataGridCheckBoxColumn Header="Primary key" Binding="{Binding PrimaryKey,Mode=OneWay}" Width="90"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   </TabControl></Border>
  </Grid>
  <Border Grid.Row="2" Background="#EBF1F8" CornerRadius="5" Padding="12,9" Margin="0,12,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Cancel operation" Command="{Binding CancelCommand}" Visibility="{Binding IsWorking,Converter={StaticResource BoolVisibility}}" Style="{StaticResource SmallButton}" Margin="8,0,0,0"/><ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="45" Height="4" Margin="0,0,12,0" Visibility="{Binding IsWorking,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Feedback}" Foreground="#4C6078" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
 </Grid>
</UserControl>
