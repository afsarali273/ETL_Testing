<UserControl x:Class="EtlTesting.Desktop.SuiteDesignerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:EtlTesting.Desktop" IsVisibleChanged="OnVisibleChanged">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisible"/>
  <local:SectionVisibilityConverter x:Key="StageVisible"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE4EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="Field" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#53677F"/><Setter Property="Margin" Value="0,9,0,5"/></Style>
  <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#65778E"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,4,0"/></Style>
  <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0067D9"/><Setter Property="BorderBrush" Value="#0067D9"/><Setter Property="Foreground" Value="White"/></Style>
  <DataTemplate x:Key="SourceColumnEditor"><ComboBox ItemsSource="{Binding DataContext.SourceColumns,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" IsEditable="True" Text="{Binding Source,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
  <DataTemplate x:Key="TargetColumnEditor"><ComboBox ItemsSource="{Binding DataContext.TargetColumns,RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" IsEditable="True" Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
  <DataTemplate x:Key="SourceColumnDisplay"><TextBlock Text="{Binding Source}" VerticalAlignment="Center"/></DataTemplate>
  <DataTemplate x:Key="TargetColumnDisplay"><TextBlock Text="{Binding Target}" VerticalAlignment="Center"/></DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <local:SuiteCaseView Visibility="{Binding Stage,Converter={StaticResource StageVisible},ConverterParameter=0}"/>
  <local:ValidationTemplatePickerView Visibility="{Binding Stage,Converter={StaticResource StageVisible},ConverterParameter=1}"/>
  <!-- Focused validation editor -->
  <Grid Visibility="{Binding Stage,Converter={StaticResource StageVisible},ConverterParameter=2}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Left" Content="← Suite" Command="{Binding BackCommand}" IsEnabled="{Binding CanInteract}"/><Border DockPanel.Dock="Right" Background="#EAF3FF" CornerRadius="4" Padding="10,6" VerticalAlignment="Center"><TextBlock Text="{Binding Editor.DraftLabel}" Foreground="#0067D9" FontSize="11"/></Border><StackPanel><TextBlock Text="{Binding Editor.TemplateName}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Editor.TemplateDescription}" Style="{StaticResource Hint}"/></StackPanel></DockPanel></Border>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><local:TemplateRuleView/></Border>
   <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Save validation" Command="{Binding SaveValidationCommand}" IsEnabled="{Binding CanInteract}" Style="{StaticResource PrimaryAction}"/><Button DockPanel.Dock="Right" Content="Preview validation" Command="{Binding PreviewValidationCommand}" IsEnabled="{Binding CanInteract}"/><Button DockPanel.Dock="Right" Content="Preview scope" Command="{Binding PreviewScopeCommand}" IsEnabled="{Binding CanInteract}" Visibility="{Binding Editor.HasScope,Converter={StaticResource BoolVisible}}"/><Button DockPanel.Dock="Left" Content="Show SQL" Command="{Binding ShowSqlCommand}" IsEnabled="{Binding CanInteract}"/><Button DockPanel.Dock="Left" Content="Cancel preview" Command="{Binding CancelCommand}" Visibility="{Binding IsWorking,Converter={StaticResource BoolVisible}}"/></DockPanel>
  </Grid>
  <!-- Advanced suite JSON remains available without displacing template editors. -->
  <Grid Visibility="{Binding Stage,Converter={StaticResource StageVisible},ConverterParameter=3}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="← Back to suite" Command="{Binding BackCommand}" DockPanel.Dock="Left"/><TextBlock Text="Advanced suite JSON" FontSize="20" FontWeight="SemiBold"/></DockPanel><TextBox Grid.Row="1" Text="{Binding JsonText,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"/><Button Grid.Row="2" Content="Validate &amp; apply JSON" Command="{Binding ApplyJsonCommand}" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Right" Margin="0,12,0,0"/></Grid>
  <Border Grid.Row="1" Background="#EDF3FB" CornerRadius="5" Padding="10,7" Margin="0,8,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding FeedbackError}" Value="True"><Setter Property="Background" Value="#FFF0EE"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Feedback}" FontSize="12" TextWrapping="Wrap" MaxHeight="68" ToolTip="{Binding Feedback}"/></Border>
 </Grid>
</UserControl>
