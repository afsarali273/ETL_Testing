<UserControl x:Class="EtlTesting.Desktop.ConnectionManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EtlTesting.Desktop">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9E3F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#152A45"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#243951"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#6D8199"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="31"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD8E6"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="31"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,3"/></Style>
  <Style x:Key="HealthAccent" TargetType="Border"><Setter Property="Background" Value="#EAF1FA"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProfile.VerificationStatus}" Value="Verified"><Setter Property="Background" Value="#E3F6EA"/></DataTrigger><DataTrigger Binding="{Binding SelectedProfile.VerificationStatus}" Value="Failed"><Setter Property="Background" Value="#FDE8E9"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="HealthText" TargetType="TextBlock"><Setter Property="Foreground" Value="#476784"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProfile.VerificationStatus}" Value="Verified"><Setter Property="Foreground" Value="#078847"/></DataTrigger><DataTrigger Binding="{Binding SelectedProfile.VerificationStatus}" Value="Failed"><Setter Property="Foreground" Value="#BF3240"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="HealthIcon" TargetType="local:StudioIcon"><Setter Property="Kind" Value="test"/><Setter Property="Foreground" Value="#476784"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProfile.VerificationStatus}" Value="Verified"><Setter Property="Kind" Value="check"/><Setter Property="Foreground" Value="#078847"/></DataTrigger><DataTrigger Binding="{Binding SelectedProfile.VerificationStatus}" Value="Failed"><Setter Property="Kind" Value="close"/><Setter Property="Foreground" Value="#BF3240"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,13"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="Connection manager" FontSize="26" FontWeight="Bold" Foreground="#101B2B"/><TextBlock Text="Manage SQL Server connections for each environment." Foreground="#62738A" Margin="0,3,0,0"/></StackPanel></DockPanel>
  <DockPanel Grid.Row="1">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanInteract}">
    <Button Command="{Binding ImportCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Import connection profiles"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="file" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Import profiles"/></StackPanel></Button>
    <Button Command="{Binding ExportCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Export connection profiles"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="save" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Export"/></StackPanel></Button>
    <Button Command="{Binding NewCommand}" Style="{StaticResource PrimaryAction}" Margin="0" AutomationProperties.Name="New connection"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="plus" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="New connection"/></StackPanel></Button>
   </StackPanel>
   <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ProfileCount}" FontWeight="SemiBold"/><TextBlock Text=" profiles  ·  " Foreground="#6D8199"/><TextBlock Text="{Binding ServerCount}" FontWeight="SemiBold"/><TextBlock Text=" servers" Foreground="#6D8199"/></StackPanel><TextBlock Text="{Binding ActiveLabel}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" Margin="0,3,8,0"/></StackPanel>
  </DockPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="240" MinWidth="200"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="405"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="HealthColumn" Width="285" MinWidth="245"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="15,15,15,12"><TextBlock Text="Saved connections" Style="{StaticResource Title}"/><TextBlock Text="Search name, server or database" Style="{StaticResource Hint}" Margin="0,5,0,0"/><Grid Margin="0,10,0,0"><TextBox Text="{Binding ProfileSearch,UpdateSourceTrigger=PropertyChanged}" Padding="28,5,5,5" AutomationProperties.Name="Search saved connection profiles"/><local:StudioIcon Kind="search" Width="14" Height="14" Foreground="#8295AA" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Margin="9,0,0,0"/></Grid></StackPanel>
    <ListBox Grid.Row="1" ItemsSource="{Binding ProfilesView}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanInteract}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="8,0" VirtualizingPanel.IsVirtualizing="True">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="10,9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#E6F0FF"/><Setter TargetName="Selection" Property="BorderBrush" Value="#B9D5FB"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="#F1F6FD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,4,0,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#8999AA"/><Style.Triggers><DataTrigger Binding="{Binding VerificationStatus}" Value="Verified"><Setter Property="Fill" Value="#0AA263"/></DataTrigger><DataTrigger Binding="{Binding VerificationStatus}" Value="Failed"><Setter Property="Fill" Value="#E04A50"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding EnvironmentName}" Style="{StaticResource Hint}" Margin="0,2,0,0"/><TextBlock Text="{Binding EndpointSummary}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EndpointSummary}" Margin="0,7,0,0"/><TextBlock Text="{Binding Database}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/><TextBlock Text="Unsaved draft" Foreground="#AC721B" FontSize="10" Visibility="{Binding IsDirty,Converter={StaticResource Visible}}" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="2" BorderBrush="#E6ECF4" BorderThickness="0,1,0,0" Padding="14,10"><StackPanel><StackPanel Orientation="Horizontal" IsEnabled="{Binding CanInteract}"><Button Command="{Binding DuplicateCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Duplicate connection"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="copy" Width="13" Height="13" Margin="0,0,5,0"/><TextBlock Text="Duplicate"/></StackPanel></Button><Button Command="{Binding DeleteCommand}" Style="{StaticResource CompactButton}" Margin="0" AutomationProperties.Name="Remove connection"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="close" Width="12" Height="12" Margin="0,0,5,0"/><TextBlock Text="Remove"/></StackPanel></Button></StackPanel><TextBlock Text="Profiles stay on this device. Draft edits stay in this session." Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
   </Grid></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" IsEnabled="{Binding HasSelection}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="16,14,16,10" BorderBrush="#E6ECF4" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="{Binding SelectedProfile.Name,TargetNullValue=Connection settings}" Style="{StaticResource Title}" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedProfile.SaveState}" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel></Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16,10,18,12" IsEnabled="{Binding CanInteract}">
     <Grid Margin="0,3,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Connection name *" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Connection profile name"/></Grid>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Environment *" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding EnvironmentSuggestions}" Text="{Binding SelectedProfile.EnvironmentName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Connection environment"/></Grid>
     <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Logical key *" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.ConnectionKey,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding SelectedProfile.KeyReadOnly}" AutomationProperties.Name="Logical connection key"/></Grid>
     <TextBlock Text="Used by suite mappings, such as warehouse or source." Style="{StaticResource Hint}" Margin="135,0,0,10"/>
     <Border BorderBrush="#E6ECF4" BorderThickness="0,1,0,0" Padding="0,10,0,9"><TextBlock Text="Server &amp; database" Style="{StaticResource Title}" FontSize="13"/></Border>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Server *" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.Server,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL Server address"/></Grid>
     <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Port" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.Port,UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional TCP port, for example 1433" AutomationProperties.Name="Optional SQL Server port"/></Grid>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Database *" Style="{StaticResource Label}"/><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox IsEditable="True" ItemsSource="{Binding Databases}" Text="{Binding SelectedProfile.Database,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL database"/><Button Grid.Column="1" Command="{Binding DiscoverCommand}" Style="{StaticResource CompactButton}" Margin="6,0,0,0" ToolTip="Discover accessible databases" AutomationProperties.Name="Discover databases"><local:StudioIcon Kind="search" Width="14" Height="14"/></Button></Grid></Grid>
     <Border BorderBrush="#E6ECF4" BorderThickness="0,1,0,0" Padding="0,10,0,9"><TextBlock Text="Authentication &amp; security" Style="{StaticResource Title}" FontSize="13"/></Border>
     <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Authentication" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding SelectedProfile.Authentication}" AutomationProperties.Name="SQL authentication method"><ComboBoxItem Content="Windows authentication" Tag="integrated"/><ComboBoxItem Content="SQL Server authentication" Tag="sql"/></ComboBox></Grid>
     <TextBlock Text="Uses your current Windows identity." Style="{StaticResource Hint}" Margin="135,0,0,7" Visibility="{Binding SelectedProfile.IsWindowsAuthentication,Converter={StaticResource Visible}}"/>
     <StackPanel Visibility="{Binding SelectedProfile.IsSqlAuthentication,Converter={StaticResource Visible}}"><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Credential storage" Style="{StaticResource Label}"/><ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding SelectedProfile.CredentialMode}" AutomationProperties.Name="SQL credential storage"><ComboBoxItem Content="Windows Credential Manager" Tag="windows"/><ComboBoxItem Content="Environment variables" Tag="environment"/></ComboBox></Grid>
      <StackPanel Visibility="{Binding SelectedProfile.UseWindowsCredentials,Converter={StaticResource Visible}}"><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="SQL username" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.UserName,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL username"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Password" Style="{StaticResource Label}"/><PasswordBox Grid.Column="1" DataContext="{Binding SelectedProfile}" DataContextChanged="PasswordContextChanged" PasswordChanged="PasswordChanged" Padding="8,6" BorderBrush="#CCD8E6" AutomationProperties.Name="SQL password"/></Grid><TextBlock Text="{Binding SelectedProfile.PasswordHint}" Style="{StaticResource Hint}" Margin="135,4,0,7"/></StackPanel>
      <StackPanel Visibility="{Binding SelectedProfile.UseEnvironmentCredentials,Converter={StaticResource Visible}}"><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Username variable" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.UserVariable,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL username environment variable"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Password variable" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.PasswordVariable,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL password environment variable"/></Grid></StackPanel>
     </StackPanel>
     <CheckBox Content="Encrypt connection (TLS)" IsChecked="{Binding SelectedProfile.Encrypt}" Margin="135,4,0,3"/><CheckBox Content="Trust server certificate" IsChecked="{Binding SelectedProfile.TrustCertificate}" Margin="135,0,0,6"/>
     <Expander Header="Advanced" Margin="0,8,0,0"><StackPanel Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Connection timeout" Style="{StaticResource Label}"/><TextBox Grid.Column="1" Text="{Binding SelectedProfile.Timeout,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Connection timeout seconds"/></Grid><TextBlock Text="Seconds · 1 to 300" Style="{StaticResource Hint}" Margin="135,4,0,0"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" BorderBrush="#E6ECF4" BorderThickness="0,1,0,0" Padding="16,9"><DockPanel IsEnabled="{Binding CanInteract}" LastChildFill="False"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Command="{Binding SaveCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Save connection profile"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="save" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Save changes"/></StackPanel></Button><Button Command="{Binding UseCommand}" Style="{StaticResource PrimaryAction}" Margin="0" AutomationProperties.Name="Use connection for suite"><TextBlock Text="{Binding UseLabel}"/></Button></StackPanel><Button Command="{Binding RevertCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Revert connection edits"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="undo" Width="13" Height="13" Margin="0,0,6,0"/><TextBlock Text="Revert"/></StackPanel></Button></DockPanel></Border>
   </Grid></Border>
   <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition x:Name="HealthRow" Height="280"/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Padding="14,13" BorderBrush="#E6ECF4" BorderThickness="0,0,0,1"><TextBlock Text="Connection test" Style="{StaticResource Title}"/></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,12"><StackPanel Orientation="Horizontal"><Border Width="35" Height="35" CornerRadius="18" Style="{StaticResource HealthAccent}" Margin="0,0,9,0"><local:StudioIcon Style="{StaticResource HealthIcon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SelectedProfile.VerificationStatus,TargetNullValue=Not tested}" Style="{StaticResource HealthText}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedProfile.VerificationMessage}" Style="{StaticResource Hint}" MaxWidth="190" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProfile.VerificationMessage}"/></StackPanel></StackPanel><Border BorderBrush="#E6ECF4" BorderThickness="0,1,0,0" Margin="0,12,0,8"/><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Server" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProfile.EndpointSummary}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProfile.EndpointSummary}"/></Grid><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Database" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProfile.Database}" FontSize="11" TextTrimming="CharacterEllipsis"/></Grid><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Tables" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProfile.VisibleTables}" FontSize="11"/></Grid><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Latency" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProfile.Latency}" FontSize="11"/></Grid><TextBlock Text="SQL SERVER VERSION" Foreground="#8395A9" FontSize="10" Margin="0,3,0,2"/><TextBlock Text="{Binding SelectedProfile.ServerVersion}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProfile.ServerVersion}"/><TextBlock Text="{Binding SelectedProfile.CheckedAt}" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel></ScrollViewer><Button Grid.Row="2" Command="{Binding TestCommand}" IsEnabled="{Binding CanInteract}" Style="{StaticResource CompactButton}" Margin="14,6,14,12" AutomationProperties.Name="Test selected connection"><StackPanel Orientation="Horizontal"><local:StudioIcon Kind="play" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Test connection"/></StackPanel></Button></Grid></Border>
    <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Padding="14,12" BorderBrush="#E6ECF4" BorderThickness="0,0,0,1"><TextBlock Text="Available schemas" Style="{StaticResource Title}"/></Border><ListBox Grid.Row="1" ItemsSource="{Binding VisibleSchemas}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid Margin="12,4"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:StudioIcon Kind="database" Width="14" Height="14" Foreground="#0067D9" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding TableLabel}" Foreground="#6D8199" FontSize="11" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="2" Text="Schemas appear after a successful test. Visibility follows SQL permissions." Style="{StaticResource Hint}" Margin="14,8,14,12"/></Grid></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" CornerRadius="5" Padding="12,8" Margin="0,11,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EAF1FA"/><Style.Triggers><DataTrigger Binding="{Binding FeedbackError}" Value="True"><Setter Property="Background" Value="#FDEBEC"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel><Button DockPanel.Dock="Right" Content="Cancel operation" Command="{Binding CancelCommand}" Style="{StaticResource CompactButton}" Visibility="{Binding IsWorking,Converter={StaticResource Visible}}" Margin="8,0,0,0"/><ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="45" Height="4" Margin="0,0,12,0" Visibility="{Binding IsWorking,Converter={StaticResource Visible}}"/><TextBlock Text="{Binding Feedback}" FontSize="11" Foreground="#435C78" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</UserControl>
